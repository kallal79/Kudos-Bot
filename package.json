{
  "name": "kudos-bot",
  "version": "2.1.0",
  "private": true,
  "description": "Least-privilege Slack /compliment app (scope: commands only)",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node kudos-bot/server.mjs",
    "demo": "node kudos-bot/demo.mjs",
    "test": "node kudos-bot/test/harness.mjs && node kudos-bot/test/audit.mjs",
    "test:e2e": "node kudos-bot/test/e2e.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude=kudos-bot/test/** kudos-bot/test/harness.mjs kudos-bot/test/audit.mjs",
    "check": "npm test && npm run demo && npm run coverage"
  }
}
